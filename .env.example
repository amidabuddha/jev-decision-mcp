# Generic decision API configuration. There is no provider preset or
# allowlist: any endpoint implementing the SDK's typed-decision contract
# (the @typesafe-ai/sdk SystemOne request) works. Copy this file to .env for a
# source build, or set the same variables in your MCP client's server
# environment.

# API credential, sent as a Bearer token. Optional at startup: tool discovery
# works without it, but decision calls return MISSING_API_KEY until it is set.
API_KEY=

# Absolute http(s) API root prefix; the SDK appends /v1/systemone. Required at
# startup; there is no default and no host allowlist. Custom path prefixes are
# supported (for example https://api.example.com/decisions). Must not include
# credentials, a query or a fragment.
BASE_URL=

# Default model name for decision calls. Required at startup; there is no
# default and no model allowlist. A per-call model argument overrides it; a
# blank or whitespace-only per-call override is rejected.
MODEL=

# --- Example endpoint/model pairs (reference only; no provider is implied).
# --- Copy one pair above and add your own API_KEY value to try it.
# TypeSafe: API_KEY=<your key> BASE_URL=https://api.typesafe.ai MODEL=jev-latest
# Liquid:   API_KEY=<your key> BASE_URL=https://api.liquid.ai/decisions MODEL=d1-ultra

# Total deadline including automatic SDK retries, in milliseconds (1-120000).
JEV_TIMEOUT_MS=30000
